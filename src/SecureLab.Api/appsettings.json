{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterOptions": { "IncludeScopes": true }
    }
  },
  "AllowedHosts": "*",
  "SearchRateLimit": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "AllowReset": false
  }
}
